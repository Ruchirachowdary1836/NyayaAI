# Copy to .env for local development. Never commit real secrets.

# --- Application ---------------------------------------------------------------
APP_ENV=development                 # "production" enforces the safety checks below
LOG_LEVEL=INFO
API_PREFIX=/api/v1
# JSON list of browser origins allowed to call the API (no "*" in production).
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Authentication --------------------------------------------------------------
# Production requires a unique value of at least 32 characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Optional bootstrap administrator (created on startup if the username is new; password >= 12 chars).
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

# --- Database ----------------------------------------------------------------------
# Local development defaults to SQLite. Production must use PostgreSQL, e.g.
#   postgresql://nyayaai:password@localhost:5432/nyayaai   (postgres:// URLs are accepted too)
DATABASE_URL=sqlite:///data/processed/nyayaai.db
# Used only by docker-compose to create its PostgreSQL container.
POSTGRES_DB=nyayaai
POSTGRES_USER=nyayaai
POSTGRES_PASSWORD=change-me-local-only

# --- Corpus and retrieval -------------------------------------------------------------
DATA_CHUNKS_PATH=data/processed/chunks.jsonl
DATA_DOCUMENTS_PATH=data/processed/documents.jsonl
INDEX_DIR=data/indices               # dense embedding cache
RESULTS_DIR=evaluation/results       # offline benchmark runs
# bm25 is always available. dense/hybrid need either EMBEDDING_PROVIDER=local with
# pip install -e ".[dense]", or EMBEDDING_PROVIDER=openai with an embeddings API key.
ENABLED_RETRIEVERS=["bm25"]
EMBEDDING_PROVIDER=local             # local | openai (OpenAI-compatible /embeddings API)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# For EMBEDDING_PROVIDER=openai (e.g. Gemini: model gemini-embedding-001, base URL
# https://generativelanguage.googleapis.com/v1beta/openai). Empty values fall back to the
# GENERATOR_API_* settings. Vectors are stored in the database and reused after restarts.
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=                # optional truncation, e.g. 768 for gemini-embedding-001
EMBEDDING_BATCH_SIZE=50
EMBEDDING_REQUESTS_PER_MINUTE=60
HYBRID_METHOD=rrf                    # rrf | weighted
HYBRID_ALPHA=0.7                     # weighted fusion: share of the dense score
HYBRID_RRF_K=60

# --- Answer generation -----------------------------------------------------------------
# ollama (local) or openai (any OpenAI-compatible chat-completions API). Keys stay server-side.
GENERATOR_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
GENERATOR_MODEL=llama3.1:8b
GENERATOR_API_BASE_URL=https://api.openai.com/v1
GENERATOR_API_KEY=
GENERATOR_TIMEOUT_SECONDS=120
QA_PASSAGE_CHARS=1200

# --- Limits ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120            # per client IP, all API routes
AUTH_RATE_LIMIT_PER_MINUTE=10        # per client IP, login/register/profile changes
QA_RATE_LIMIT_PER_MINUTE=10          # per user, answer generation
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_DOCUMENTS_PER_USER=200
EXPERIMENT_MAX_QUERIES=25

# --- Frontend (build-time, read by Vite from frontend/.env.local or the environment) ----
VITE_API_BASE_URL=http://localhost:8000
